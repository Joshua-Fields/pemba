# Schema fixtures are compared byte-for-byte with canonical (LF) printer output, so
# Windows checkouts must not convert them to CRLF.
*.zed text eol=lf

# Fixtures are LF in the repository; the runner also accepts CRLF (docs/07-testing.md §3).
*.yaml text eol=lf

# Migration scripts are embedded with include_str!; a CRLF checkout would store different
# schema SQL text in sqlite_master on Windows than on every other platform.
*.sql text eol=lf

# rustfmt.toml sets newline_style = "Unix", so `cargo fmt --check` fails on every Rust file a
# Windows checkout with core.autocrlf=true converts to CRLF.
*.rs text eol=lf

# Fuzz inputs are raw bytes named by their SHA-1 (libFuzzer, fuzz/seed_corpus.py): never
# convert line endings in either direction, or an input stops being the one that was found.
fuzz/corpus/** -text
