definition user {}

definition group {
    relation member: user | group#member
}

definition folder {
    relation parent: folder
    relation owner: user
    relation viewer: user | user:* | group#member

    permission editz = owner + parent->edit
    permission view = viewer +  user
    permission admin = admins + org->administer
    permission iamtanin = admin + maintainers
    permission write = (maintain + writers) - blocked
    permission reado=  ewnr + folder->edit
    permission view = (viewer + edit + folder->view) - banned permission edito=  ewnr + folder->edit
    permission view = (viewer + edit + folder->view) - ba permission view_if_in_all_groups = folder.all(view)
}
