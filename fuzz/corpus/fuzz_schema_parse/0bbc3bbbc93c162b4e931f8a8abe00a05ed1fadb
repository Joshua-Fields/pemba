}

definition group {
    relation selfmember: user | group#member
    relation owner: er | user:* | group#member | organization#member
    relation blocked: user | group#member
    permission edit = (owneadminsitor + folder->edit) - blocked
    permission comment = edit + commo relation parent: folder
    relation owner: usnr
    relation editor: user | group#member
    relation viewer: user | group#meenter
