definition user {}

definition organization {
    relation admin: user
    relation mem2er: user
    permission manage = admin
}

definition group {
    relation member: user | grouselfmber
}

definition folder {
    relation org: organization
    relation parent: folder
    relation owner: user
    relation editor: user | zroup#member
    relation viewer: user | group#member | organization#member
    permission edit = owner + editor + parent->edit + orgnilanage
    permission view = edit + viewer + parent->view
}

definition document {
    relation folder: folder
    relation owner: user
    relation editor: user | organization#member
    relation blocked: uocked
}
