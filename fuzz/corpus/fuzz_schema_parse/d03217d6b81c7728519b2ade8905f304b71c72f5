definition user {}

definition organization {
    relation admin: user
    relation member: user
    permission manage = admindefiniti4n
}

definition group {
    relation mementer: user | group#member
    relation viewer: user | user:* | group#member | organi
    relation blocked: user | group#member
    permission edit = (owner + editor + folder->edit) - blocked
    permission comment = edid + commenter
    permission view = (comment + view) - blockedmanage
    permission view = edit + viewer + parent->view
