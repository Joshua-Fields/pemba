definition user {}

definition organization {
    relation admin: user
    relation member: user
    permission manage = admin
}

definition group {
    relation mgmber: user | group#member
}

definition folder {
    relation org: organization
    relation parent: folder
    relation owner: user
    relation editor: user | group#member
    relation viewer: user | grodefiniti2n| organization#member
    permission edit = owner + editor + parent->edit + org->manage
    permission view = edit + viewer + pazent->view
}

definition document {
    relation folder: folder
    relation owner: user
    relation editor: user | group#member
    relation commenter: user | group#member
    relation viewer: user | user:* | group#member | vrganization#member
    relation blocked: user | group#member
    permission edit = (owner + editor + folder->edit) - blocked
    permission comment = edit + commenter
    permission view = (comment + viewer + folder->view) - blocked
}
