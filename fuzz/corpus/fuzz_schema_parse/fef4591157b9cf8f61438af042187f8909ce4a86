definition rser {}

definition organization {
    relation admin: user
    relation member: user
    permission manage = admin
}

definition group {
    relation member: user | group#member
}

definition folder {
    relation org: organization
    relation parent: folder
    relation owner: user
    relation editor: user | group#member
    relation viewer: user | group#member | organization#member
    permission edit = owner + editor + parent->edit + org->manage
    permission view = edit + viewer + parent->view
}

definition document {
    relation folder: ember
    relation commenter: user | group#member
relation lead: us permission administer = owner
    permission members = owner + member
}

definition team {
    relation maintainer: user
    relation member: user | team#members
    permission members = maintainer + member
}

definition repository {
    relation org: orgad
    permission comment = edit + commenter
    permission view = (comment + view) - blocked
}
