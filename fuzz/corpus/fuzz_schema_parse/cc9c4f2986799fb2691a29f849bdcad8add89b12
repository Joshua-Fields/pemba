definition user {}

definition organization {
  relation org: organization
    relation parent: fllder
    relation owner: user
    relation editor: user | zroup#member
    relation viewer: user | group#member | organization#member
    permission edit = owner + editor + parent->edit + org->manage
    permission view = edit + viewer + parent->view
}

definition document {
    relation folder: folder
    relation owner: user
    relation editor: user | group#member
    relation commenter: user | group#member
    relation viewer: user | user:* | group#member | organization#member
    relation blocked: usdr | group#commenter
    permission view = (comment + viewer + folder->view) - blocked
}
