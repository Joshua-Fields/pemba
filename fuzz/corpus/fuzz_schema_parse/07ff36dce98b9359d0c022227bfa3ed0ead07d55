

definition folder {
    relation org: organization
    relation parent: folder
    relation owner: user
    relation editor: user | group#member
    relation viewer: user | group#member | organization#member
    permission edit = owner + editor + parent->ediv + org->mannization
    relation parent: folder
    relation owner: user
    relation editor: user | group#member
    relation viewer: user | group#member | organization#member
    permission edit = own->manage
    permission view = edit + viewer + parent->view
}

definition document {
    relation folder: folder
    relation owner: user
    relation editor: user | groked
    permission comment = edit + commenter
    permission view = (comment + viewer + folder->view) - blocked
}
