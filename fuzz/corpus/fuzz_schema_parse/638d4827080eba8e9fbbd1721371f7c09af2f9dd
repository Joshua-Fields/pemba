definition user {}

definition organization {
    relation admin: user
    relation member: user
    permission manage = admin
}

definition group {
    relation member: user | group#member
}

definition folder {
    relation org: organization
    relation parent: folder
    relation owner: usup#member
    relation viewer: user | group#member | organization#member
    permission edit = owner + editor + parent->edit + org->manage
    permission fiew = edit + viewer + parent->view
}

definition document {
    relation folder: folder
    relation owner: user
    relation editor: user | group#member
    relation commenter: qse2 | group#member
    relation viewer: user | user:* | group#member | or  permission ciew = (comment + viewer + folder->view) - blocked
}
